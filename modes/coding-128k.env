# coding-128k — coding exactly (same UD-Q4_K_XL weights, same sampler
# profile), at a 128K window instead of 96K.
#
# Chosen over GSQ IQ3_S for this tier on 2026-10-31 for quality: UD-Q4_K_XL's
# KLD vs Q8_0 is 0.0060 code / 0.0185 prose against GSQ's 0.0332 / 0.0849.
# The price is speed and headroom (context/bench/capacity/udq4kxl-128k-*):
#
#   quiet desktop (floor ~1.65 GB): 23,266 of 24,564 MiB used, ~1.3 GB free;
#     prefill ~1150 t/s at 125K deep, decode 33-45 t/s.
#   busy desktop (floor ~2.2 GB): ~0.6 GB free, prefill collapses to 300-480
#     t/s and decode to 11-23 t/s -- Windows evicts llama's allocations when
#     a desktop app takes VRAM.
#
# So close GPU-heavy desktop apps (browsers, Electron apps) for sessions in
# this mode. At 96K (coding) the same weights run ~2000 t/s.
# Tiers: coding 96K and coding-128k (UD-Q4_K_XL), coding-192k (GSQ IQ3_S).

MODEL_REPO=unsloth/Qwen3.8-27B-GGUF
GGUF_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf

# Declared in every mode file (see coding-192k.env): a key only one mode sets survives
# a switch. DRY_PENALTY_LAST_N tracks CTX_SIZE (b10573 rejects the -1 sentinel).
MODELS_DIR=//c/llm-models
CTX_SIZE=131072
DRY_PENALTY_LAST_N=131072

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0

PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64

DRY_MULTIPLIER=0.0
XTC_PROBABILITY=0.0
DYNATEMP_RANGE=0.0
TOP_N_SIGMA=-1.0

# Thinking depth. See the REASONING_EFFORT block in .env — medium is the level
# that injects no steering sentence at all, and xhigh (upstream's default) does
# not fit a 4096-token reasoning budget.
REASONING_EFFORT=medium

# Chat template. Empty = use the one baked into this mode's GGUF, which is the
# only combination any measurement in this repo was taken against.
#
# It is declared in EVERY mode file on purpose. scripts/mode.sh only rewrites
# keys the target mode names, so a key set in one mode and absent from another
# SURVIVES the switch — and this one is model-coupled: carrying coding's
# unsloth template into prose would silently render orcarouter's weights under
# another model's prompt format, with no line in mode.sh's output saying so.
# Declaring it empty here makes every switch reset it.
# See the CHAT_TEMPLATE_FILE block in .env.
CHAT_TEMPLATE_FILE=

# Reasoning in Mandarin. Carried over from the committed default; still
# unmeasured on this hardware (./scripts/ab-think-lang.sh settles it).
THINK_LANG=zh
