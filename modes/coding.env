# coding — the regime the committed 0.913 / 27-27 scorecard was measured in.
#
# Sampling is Qwen's published "thinking mode, precise coding" preset. Every
# creative sampler is at llama.cpp's disabled value, because that is what was
# measured; turning one on invalidates the comparison to results/latest.json.
#
# Source: Qwen3.6 model card, "Best Practices" —
#   temperature=0.6, top_p=0.95, top_k=20, min_p=0.0,
#   presence_penalty=0.0, repetition_penalty=1.0

MODEL_REPO=unsloth/Qwen3.6-27B-MTP-GGUF
GGUF_FILE=Qwen3.6-27B-UD-Q4_K_XL.gguf

TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64

DRY_MULTIPLIER=0.0
XTC_PROBABILITY=0.0
DYNATEMP_RANGE=0.0
TOP_N_SIGMA=-1.0

# Reasoning in Mandarin. Carried over from the committed default; still
# unmeasured on this hardware (./scripts/ab-think-lang.sh settles it).
THINK_LANG=zh
