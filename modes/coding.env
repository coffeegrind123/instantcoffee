# coding — the default regime, on the mainline unsloth Qwen3.8 quant.
#
# Sampling is Qwen's published thinking-mode preset. Every creative sampler is
# at llama.cpp's disabled value.
#
# Source: Qwen3.8-27B model card, "Best Practices", thinking mode —
#   temperature=1.0, top_p=0.95, top_k=20, min_p=0.0,
#   presence_penalty=0.0, repetition_penalty=1.0
#
# 1.0, not the 0.6 this mode ran at on 3.6. That 0.6 was Qwen3.6's separate
# "precise coding" preset; the 3.8 card publishes ONE thinking preset and it is
# 1.0. The GGUF agrees — general.sampling.temp=1.0 is stamped into the file
# metadata, along with top_k=20 and top_p=0.95.
#
# There is no scorecard for this mode and no way to regenerate one here. The old
# 0.913 / 27-27 figure was measured on 3.6 at 0.6, so it describes neither this
# model nor this temperature, and the whole eval harness (eval.py,
# eval_harness.py, run-eval.sh, gen-readme-scorecard.py) was DELETED on
# 2026-08-15 rather than left to rot. Do not go looking for run-eval.sh: it is
# gone on purpose and .github/workflows/ci.yml fails the build if any of those
# files reappear. Judge this mode with ./scripts/smoke-test.sh and
# ./scripts/bench.sh, which measure what actually runs.

MODEL_REPO=unsloth/Qwen3.8-27B-GGUF
GGUF_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0

PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64

DRY_MULTIPLIER=0.0
XTC_PROBABILITY=0.0
DYNATEMP_RANGE=0.0
TOP_N_SIGMA=-1.0

# Thinking depth. See the REASONING_EFFORT block in .env — medium is the level
# that injects no steering sentence at all, and xhigh (upstream's default) does
# not fit a 4096-token reasoning budget.
REASONING_EFFORT=medium

# Chat template. Empty = use the one baked into this mode's GGUF, which is the
# only combination any measurement in this repo was taken against.
#
# It is declared in EVERY mode file on purpose. scripts/mode.sh only rewrites
# keys the target mode names, so a key set in one mode and absent from another
# SURVIVES the switch — and this one is model-coupled: carrying coding's
# unsloth template into prose would silently render orcarouter's weights under
# another model's prompt format, with no line in mode.sh's output saying so.
# Declaring it empty here makes every switch reset it.
# See the CHAT_TEMPLATE_FILE block in .env.
CHAT_TEMPLATE_FILE=

# Reasoning in Mandarin. Carried over from the committed default; still
# unmeasured on this hardware (./scripts/ab-think-lang.sh settles it).
THINK_LANG=zh
