# anthropic — the hosted Anthropic backend, with no local model containers.
#
# This profile is the contract for the hosted path: the main session runs
# claude-opus-5-5, subagents run claude-haiku-5-5, and the advisor runs
# claude-fable-5-1. scripts/mode.sh publishes these values into .env and asks
# pi-local.sh --install-only to regenerate pi's provider configuration. It must
# never start or recreate llama or forge. Relaunch pi after switching because a
# running session keeps the provider and context window it read at launch.
#
# Provenance: these model ids and limits are the hosted-mode configuration
# specified for this stack on 2026-11-05. The API credential is intentionally
# absent: set ANTHROPIC_API_KEY in the gitignored .env.local.
#
# Context accounting and cache policy for the current 1M-token hosted models.
# Long retention plus idle warming favors resumable agent sessions; compaction
# begins at 28% and keeps the most recent 15%. Cache-miss notices and launch
# model refresh stay on because the hosted catalog and cache behavior are
# provider-controlled. The actual model window comes from pi's catalog.
#
# Switching back with `./scripts/mode.sh local` restores the mode named by
# STACK_LAST_LOCAL_MODE. Restarting local llama is opt-in, never a side effect
# of leaving this profile.

STACK_BACKEND=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_SUBAGENT_MODEL=claude-haiku-5-5
ANTHROPIC_ADVISOR_MODEL=claude-fable-5-1
PI_CONTEXT_WINDOW=1000000
PI_CACHE_SHORT_SECONDS=300
PI_CACHE_LONG_SECONDS=3600
PI_CACHE_WARMING=idle
PI_SHOW_CACHE_MISS_NOTICES=1
PI_CACHE_RETENTION=long
PI_UPDATE_MODELS_ON_LAUNCH=1
PI_COMPACTION_AT_PCT=0.28
PI_COMPACTION_KEEP_PCT=0.15
PI_OFFLINE=0
THINK_LANG=off
ORCHESTRATOR=1
SUBAGENTS_ENABLED=1
SUBAGENT_MODEL=anthropic/claude-haiku-5-5
ADVISOR_MODEL=anthropic/claude-fable-5-1
