# prose — a decensored Qwen3.8 build, set up for fiction rather than code.
#
# The 3.6 regime this replaces ran DavidAU's Fable-Fusion-711 NEO-MAX-MTP merge.
# There is no 3.8 equivalent of it: at the time of the switch DavidAU had
# published exactly one 3.8 model (Cold-Fusion-GAIN-V1.1, no GGUF, no downloads),
# so the whole Fable-Fusion card — its temp<=1 MTP ceiling, its rep-pen ban, its
# smoothing_factor request — no longer applies to anything on disk. None of that
# reasoning is carried over here. What replaces it:
#
# JonathanColetti/Qwen3.8-27B-Uncensored-GGUF, chosen because it is the only 3.8
# decensored GGUF that publishes measurements rather than adjectives:
#   - Heretic (p-e-w/heretic) refusal-direction removal at bf16, LoRA merged into
#     the bf16 base — not a quantized round trip, no fine-tuning.
#   - Refusals on 100 held-out harmful prompts: 98/100 base -> 12/100 this model,
#     at KL 0.1191 vs base. The full 23-point Pareto front is on the model card.
#   - Capability delta vs base, 0-shot lm-eval: MMLU -0.2, ARC-C -1.2,
#     HellaSwag +0.1, Winogrande -0.8, mean -0.5 — all inside reported stderr.
#   - MTP survives: abliteration re-saves through transformers, which silently
#     drops the MTP head while config.json still advertises it, so the publisher
#     grafts blk.64 back from base and inspects every file (65/65 blocks).
#     Confirmed here independently before selection by reading the GGUF header
#     off the Hub: block_count=65, nextn_predict_layers=1, 866 tensors,
#     blk.64.nextn.* present. So --spec-type draft-mtp works in this mode too.
#
# Known cost, stated by the publisher: the draft head was trained against the
# unmodified weights, so acceptance rate may fall. Speculative decoding verifies
# every drafted token against the target, so this is a speed risk, never a
# quality one — if prose decode is slower than coding decode, that is why.
#
# Sampling is Qwen3.8's published thinking-mode preset (the card publishes one):
#   temperature=1.0, top_p=0.95, top_k=20, min_p=0.0,
#   presence_penalty=0.0, repetition_penalty=1.0

MODEL_REPO=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF
GGUF_FILE=Qwen3.8-27B-Uncensored-IQ4_XS.gguf

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0

PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64

# DRY penalises repeated *sequences* rather than repeated tokens, which is what
# keeps long fiction from collapsing into the same phrasing without flattening
# style the way a flat repeat penalty does. Kept at 0.8 from the 3.6 prose
# regime as a preference, not as a card requirement — the old justification (the
# Fable-Fusion card forbidding rep-pen on MTP quants) died with that model.
# Zero it to run Qwen's preset unmodified.
DRY_MULTIPLIER=0.8
XTC_PROBABILITY=0.0
DYNATEMP_RANGE=0.0
TOP_N_SIGMA=-1.0

# Thinking depth. medium injects no steering sentence; xhigh (upstream default)
# spends the whole REASONING_BUDGET planning a scene before writing a word.
REASONING_EFFORT=medium

# No reasoning-language fragment: it is a page of instructions about verbatim
# tool arguments and code identifiers, which is dead weight in a fiction session.
THINK_LANG=off

# WATCH max_tokens IN PROSE MODE. This is a thinking model and REASONING_BUDGET
# is 4096, so a request has to leave room for the thinking block *and* the prose.
# Measured on the 3.6 prose model: a "150 word noir scene" spent 4212 characters
# on reasoning and returned 913 characters of story, 1286 completion tokens in
# total. Ask for max_tokens=400 and you get an EMPTY content field and
# finish_reason=length — the thinking ate the whole budget, and llama's
# --reasoning-format deepseek puts it in reasoning_content where a naive client
# never looks. 3.8 thinks MORE than 3.6 at a given effort level, not less, so
# treat that measurement as a floor.
#
# So: keep max_tokens well above REASONING_BUDGET (pi's PI_MAX_TOKENS=8192 is
# fine), or set REASONING_BUDGET=0 for non-thinking prose — in which case Qwen's
# published non-thinking preset is temperature=0.7, top_p=0.80, top_k=20,
# presence_penalty=1.5, which is a different regime from the one above.
