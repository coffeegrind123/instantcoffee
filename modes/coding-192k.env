# coding-192k — coding's exact sampler profile at a 192K window, on GSQ-RCO IQ3_S.
#
# Opt-in, never the default. The window is what this mode buys; the weights
# are what it pays with. Measured 2026-10-31 on b12019:
#
#   KLD vs Q8_0 (decisions.md 2026-10-31): GSQ IQ3_S 0.0332 code / 0.0846 prose,
#   against coding's UD-Q4_K_XL at 0.0060 / 0.0185 -- about 5x the divergence,
#   top-1 down ~2.4 pt on code and ~6.6 pt on prose. Use coding (96K) or
#   coding-128k (UD-Q4_K_XL, 128K) unless the session genuinely needs more than 128K.
#
#   Fit (context/bench/capacity/gsq-192k-at155k-b12019.json): 22,771 of 24,564
#   MiB used at 192K (11,159 weights + ~7.2 GB KV + compute + the desktop
#   floor), ~1.8 GB free.
#
#   Why 192K and not 200K: at 155K deep, a 192K window ran ~1624 t/s prefill /
#   40-45 t/s decode -- the same as a 160K window (~1608 / 38-46). A 200K window
#   left ~1.1 GB free and ran ~1180 / 20-30 at the same depth
#   (gsq-200k-at155k-b12019.json). 4% less window for full speed.
#
#   Speed: prefill ~1990 t/s at 90K deep, ~1620 at 155K; decode ~40-45 t/s at
#   155K. All of this card's slow runs on 2026-10-31 coincided with the Windows
#   desktop holding ~2.3 GB of VRAM instead of ~1.4-1.6 GB; keep GPU-heavy
#   desktop apps closed during long sessions.
#
# Stock weights only. GSQ's quantization pipeline is not public, so there is no
# uncensored GSQ mode; uc-coding and prose stay capped at 128K.
#
# The GGUF is on D: (spinning disk), not C:'s NVMe like the other modes, because
# C: had 8 GB free and this file is 12.1 GB. A cold switch can therefore take
# up to ~90 minutes when the page cache does not hold the file (see the
# MODELS_DIR block in .env). Moving it to C: is a copy plus changing
# MODELS_DIR below to //c/llm-models.
#
# CTX_SIZE, DRY_PENALTY_LAST_N and MODELS_DIR are declared in EVERY mode file:
# mode.sh only rewrites keys the target names, so a key set only here would
# survive a switch back to coding and keep the 192K window and the D: path.
# Tiers: coding 96K (UD-Q4_K_XL), coding-128k (UD-Q4_K_XL), coding-192k (GSQ IQ3_S).

MODELS_DIR=//d/llm-models
MODEL_REPO=ISTA-DASLab/Qwen3.8-27B-GSQ-RCO-GGUF
GGUF_FILE=Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf

# DRY_PENALTY_LAST_N tracks CTX_SIZE (b10573 rejects the old -1 sentinel).
CTX_SIZE=196608
DRY_PENALTY_LAST_N=196608

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0

PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0
REPEAT_PENALTY=1.0
REPEAT_LAST_N=64

DRY_MULTIPLIER=0.0
XTC_PROBABILITY=0.0
DYNATEMP_RANGE=0.0
TOP_N_SIGMA=-1.0

# Thinking depth. See the REASONING_EFFORT block in .env — medium is the level
# that injects no steering sentence at all, and xhigh (upstream's default) does
# not fit a 4096-token reasoning budget.
REASONING_EFFORT=medium

# Chat template. Empty = use the one baked into this mode's GGUF, which is the
# only combination any measurement in this repo was taken against.
#
# It is declared in EVERY mode file on purpose. scripts/mode.sh only rewrites
# keys the target mode names, so a key set in one mode and absent from another
# SURVIVES the switch — and this one is model-coupled: carrying coding's
# unsloth template into prose would silently render orcarouter's weights under
# another model's prompt format, with no line in mode.sh's output saying so.
# Declaring it empty here makes every switch reset it.
# See the CHAT_TEMPLATE_FILE block in .env.
CHAT_TEMPLATE_FILE=

# Reasoning in Mandarin. Carried over from the committed default; still
# unmeasured on this hardware (./scripts/ab-think-lang.sh settles it).
THINK_LANG=zh
