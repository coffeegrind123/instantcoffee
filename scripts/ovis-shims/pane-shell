#!/usr/bin/env bash
#
# herdr's shell for every new pane: pi first, then bash.
#
# A new workspace or tab in Ovis opened herdr's default pane, a plain shell, so
# Ovis showed "Message Shell" or a terminal rather than a pi chat (2026-11-01).
# herdr runs $SHELL for each new pane, and scripts/ovis.sh starts herdr with
# this script as its SHELL. An interactive pane runs pi through pi-local.sh in
# the pane's directory; quitting pi leaves an ordinary bash there.
#
# Anything that runs `$SHELL -c ...` (or any other arguments) gets plain bash,
# and so does a pane that asks for it (OVIS_PANE_PLAIN=1: `ovis.sh run` types
# its own launch into the pane) or OVIS_PI_PANE=0 in the stack's env files.

real_bash="${OVIS_PANE_BASH:-/bin/bash}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Arguments other than a login flag are a command, not a pane.
case "${1:-}" in
  "" | -l | --login | -i) ;;
  *) exec "$real_bash" "$@" ;;
esac

# What runs inside the pane (an editor's :sh, pi's own tools) gets bash.
export SHELL=/bin/bash

pi_pane() {
  [[ "${OVIS_PANE_PLAIN:-}" == "1" ]] && return 1
  local value
  value="$(source "$here/../lib.sh" && env_get OVIS_PI_PANE 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [[ ! "$value" =~ ^(0|false|no|off)$ ]]
}

if pi_pane; then
  "$here/../pi-local.sh"
fi
exec "$real_bash" -i
