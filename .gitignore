# Machine-local overrides, merged on top of the committed .env by the scripts.
.env.local

# Transient backup written by update.sh while it applies a change.
.env.bak

# Whole-file .env backup held by scripts/spec-sweep.sh for the length of a
# sweep. It lives here rather than in TMPDIR on purpose (see the comment in
# that script); a copy left behind means a sweep died without restoring, and
# the next sweep refuses to start until it is dealt with.
.env.spec-sweep-backup

# Models are large binaries fetched by scripts/download-model.sh. They live in
# MODELS_DIR, outside the repo, but guard against a stray copy landing here.
*.gguf
models/
__pycache__/

# Per-iteration log written by /loop (vendor/pi-loop-mode) into the working
# directory it is looping on, which is sometimes this one. `/loop stats` reads it.
.pi-loop-log.jsonl

# Ad-hoc measurement output. The scored eval harness that used to commit results
# here was removed on 2026-08-15; nothing writes this directory automatically any
# more except ./scripts/ab-think-lang.sh --save.
results/

# Whole-file .env backup held by scripts/capacity-probe.sh for the length of a
# probe run. Same reasoning as .env.spec-sweep-backup above.
.env.capacity-probe-backup
