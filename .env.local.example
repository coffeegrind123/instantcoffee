# .env.local.example — machine-local overrides that should NOT be committed.
#
# Copy to .env.local and edit. The scripts merge it on top of .env, so only
# the keys you actually set here override the committed defaults.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored.

# --- Model storage (REQUIRED — must be a Windows path on Docker Desktop) -----
# MODELS_DIR=//d/llm-models

# --- GPU tuning -------------------------------------------------------------
# If you have more/less than 24 GB VRAM, adjust context and cache sizes here.
# CTX_SIZE=32768
# CACHE_RAM=4096

# --- Network ----------------------------------------------------------------
# BIND_ADDR=0.0.0.0    # expose on the LAN
# LLAMA_PORT=8080
# FORGE_PORT=8081

# --- pi ---------------------------------------------------------------------
# PI_EXTRA_ARGS=--approve
# PI_CONTEXT_FILES=0     # on by default; 0 passes -nc and skips AGENTS.md
# PI_MAX_TOKENS=8192     # keep LLAMA_EXTRA_FLAGS' -n in step with this

# --- MCP via CLI ------------------------------------------------------------
# MCP2CLI_ENABLED=0     # on by default; set 0 to drop the mcp-tools skill

# --- Matrix channel ---------------------------------------------------------
# Off by default for two reasons: it logs a bot into a homeserver and makes the
# session addressable from the internet, and its six tool schemas cost ~1,470
# tokens of every request. Setting it here makes it permanent for this machine;
# prefer the one-launch form below if you only occasionally want Matrix.
# PRINNY_ENABLED=1

# --- persona -----------------------------------------------------------------
# /persona is on by default and costs nothing until a persona is active. Once
# one is, it is ~3,683 tokens of every request (~2,311 on `lean`) against a
# 32,768-token window — /persona status prints the live number.
# PERSONA_ENABLED=0        # drop /persona entirely
# PERSONA_PROMPT_MODE=lean # the same contract, ~1,372 tokens cheaper
# PERSONA_IMMERSION=immersion  # DeepSeek-only thinking-mode marker; unmeasured here

# --- pi in a container (optional) --------------------------------------------
# Set this and ./scripts/pi-container.sh works; leave it empty and it refuses
# rather than guessing. It is the agent home AS THE DOCKER DAEMON SEES IT — on
# Docker Desktop, docker's form of the Windows path, never a WSL path.
# PI_CONTAINER_HOME_HOST=//c/path/to/pi-home
# PI_CONTAINER_EXTRA_ARGS=-v //c/path/to/scratch:/home/piuser/scratch

# --- pi updates -------------------------------------------------------------
# PI_AUTO_UPDATE=0        # pin the installed pi instead of tracking npm latest
# PI_UPDATE_INTERVAL_H=72 # check less often

# Any key here can also be set for ONE launch, without editing a file:
#   PI_CONTEXT_FILES=1 ./scripts/pi-local.sh

