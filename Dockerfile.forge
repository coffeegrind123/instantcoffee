# forge guardrail proxy.
#
# Built from PyPI rather than from forge's own git checkout so that "update" is
# a one-line version bump in .env (scripts/update.sh does exactly that) instead
# of a submodule dance.
#
# huggingface_hub ships in the same image on purpose: the model downloader and
# the smoke test both run from this image, which keeps the stack down to two
# images total instead of four.

FROM python:3.13-slim

ARG FORGE_VERSION
# Fail the build early and loudly rather than silently installing "latest".
RUN test -n "$FORGE_VERSION" || (echo "FORGE_VERSION build-arg is required" >&2; exit 1)

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# No [anthropic] extra. That extra pulls the Anthropic SDK, which forge imports
# in exactly one place — a lazy, function-local import inside the branch that
# handles an Anthropic-shaped *backend* (forge/proxy/proxy.py). This stack's
# backend is llama.cpp on the OpenAI wire, so the import never runs. forge's
# inbound /v1/messages route is unaffected either way: it is pure-python
# conversion in forge/proxy/convert_anthropic.py and needs no SDK. Verified
# against the 0.8.2 wheel, not assumed.
RUN pip install --no-cache-dir \
        "forge-guardrails==${FORGE_VERSION}" \
        "huggingface_hub[hf_xet]>=0.27" \
    && useradd --create-home --uid 1000 forge \
    && mkdir -p /work \
    && chown -R forge:forge /work

# forge's _merge_consecutive() concatenates message content with `+`, which
# raises TypeError the moment a message carries a LIST of content blocks instead
# of a string — i.e. any time two same-role messages end up adjacent, which is
# exactly what happens when a request fails and the user retypes it. Present in
# both 0.8.2 and 0.9.0. The patcher verifies the source text and exits non-zero
# if forge has changed it, so an upgrade fails the build rather than silently
# shipping unpatched. See patches/forge_merge_consecutive.py.
#
# The second patch restores llama-server's prompt-cache counter. forge rebuilds
# the OpenAI usage dict with three keys and drops `prompt_tokens_details`, which
# is the exact field pi reads for its cache-hit display — so every session on
# this stack reported cacheRead: 0 while llama's own logs showed prefix reuse up
# to f_sim_best 0.988. Measured as a matched pair against both ports, not
# inferred. See patches/forge_cached_tokens.py.
#
# The third patch stops forge destroying a reasoning-only turn. TextResponse
# carries content and nothing else, so when the model produces reasoning and no
# text — which Qwen does — the client builds TextResponse(content="") and
# everything generated is gone before the response is assembled. Matched pair
# against both ports: llama-server returned finish_reason "length" with 490
# chars of reasoning_content; forge returned "stop" with no reasoning key at
# all, and pi recorded a clean, successful, EMPTY turn. Reasoning is emitted as
# reasoning_content, never merged into content, so a harness sees it as thinking
# and a chat channel that relays assistant text does not relay it.
# See patches/forge_reasoning_passthrough.py.
#
# The fourth patch stops forge destroying the model's own words on a TOOL-CALL
# turn. A forge ToolCall carries `reasoning` and has NO content field, so the
# assistant text that came with the call has nowhere to live, and
# tool_calls_to_openai fills `content` with the reasoning instead. Matched pair,
# identical request: llama returned content "I'm going to look up the current
# weather in Paris for you." plus separate reasoning; forge returned the
# REASONING as content, no reasoning_content key, and the sentence gone. With
# FORGE_REASONING_REPLAY=full that reasoning is a text block — which is exactly
# what the third patch's docstring says must not happen, on the path it does not
# cover. The replay policy itself is untouched: it is really implemented inbound
# by filter_openai_reasoning_messages. See patches/forge_toolcall_content.py and
# context/design/forge-on-the-tool-call-path.md.
#
# The fifth patch stops _merge_consecutive folding every user turn into the
# FIRST user message. That merge is upstream's workaround for llama-server's
# MISTRAL template parity checker, which counts only plain user/assistant
# messages; on Qwen3.8's template — which renders a tool result as its own turn
# and has no such constraint, verified against the live /apply-template — it
# rewrites the prompt PREFIX every agentic turn and pins the KV cache. Measured:
# without forge the reused prefix grows 391 -> 513 across three turns, through
# forge it is flat at 352 -> 352. Adjacent same-role merges (the retry nudge)
# still happen; the cross-tool case is opt-in via FORGE_MERGE_ACROSS_TOOLS=1.
# Applied AFTER forge_merge_consecutive.py, which patches a different line of
# the same function. See patches/forge_merge_across_tools.py.
# The sixth patch closes patch three's hole on the ANTHROPIC wire, where it was
# not merely absent but inverted. tool_calls_to_anthropic emitted the model's
# reasoning as a `text` block — the one block type vendor/prinny-channel
# forwards to a Matrix room — and text_response_to_anthropic had neither a
# `reasoning` nor a `finish_reason` parameter at all, so a reasoning-only turn
# lost everything and every response claimed "end_turn" whether it finished or
# was cut at max_tokens. Reasoning now lands on a top-level reasoning_content
# key, mirroring the OpenAI wire; NOT as an Anthropic `thinking` block, because
# that carries a `signature` the API issues and verifies and this proxy cannot
# mint one — a fabricated signature is a forged attestation in a durable
# transcript. Applied LAST: it edits the _emit_text that
# forge_reasoning_passthrough.py rewrites, so it must see the patched text.
# See patches/forge_anthropic_reasoning.py.
# The seventh patch closes patch three's hole on the path an AGENT turn takes.
# handler.py hands a text response back in two places; patch three fixed the
# first and did not touch the second, four lines below it — the `except
# ToolCallError` passthrough, which emitted the text alone with no `reasoning`
# and no `finish_reason`. That branch is not an edge case: forge counts a bare
# text reply as a validation failure whenever the request carries tools, and
# FORGE_MAX_RETRIES=0 sends it straight here, so with pi (which sends tools every
# turn) it is the MAJORITY path. Measured as a 2x2 with a no-tools control,
# identical bodies, same minute: reasoning_content came back 193/161 chars
# through forge without tools and 0/0 with them, while llama-server returned
# 156/146 and 192/155 across the same four cells. The visible symptom was a turn
# that stopped mid-word with "Reasoning budget reached..." — llama's
# --reasoning-budget-message, injected before the end-of-thinking tag — stapled
# to the end of the CONTENT, reported as finish_reason "stop", with the tool call
# that llama had actually emitted gone. pi records that as a clean completed turn,
# so nothing retries and the loop stops. Applied AFTER forge_reasoning_passthrough.py,
# whose TextResponse fields it carries; it verifies that ordering and refuses to
# run otherwise. See patches/forge_toolcall_passthrough.py.
#
# Patch 8 closes the one exit from run_inference that said NOTHING on the way
# out. forge has two budgets — FORGE_MAX_RETRIES bounds the attempt loop,
# FORGE_MAX_TOOL_ERRORS bounds tool-error kinds — and with .env's 0 and 2 the
# second outlives the first: the first malformed tool call is "not exhausted",
# so forge appends a correction for an attempt it will never make, falls out of
# its own loop and returns None, which handler.py turns into an empty 200 with
# no usage, no finish_reason and no log line. Measured on a live unattended /loop
# run: 20+ consecutive turns of the full 8,192-token generation cap (~85 s of GPU
# each) delivered to pi as `content: []` reported as a natural "stop", with the
# whole run making zero file changes. Truncation is what produces it —
# decode_tool_args hands back the raw string when a tool call is cut off
# mid-JSON. Applied AFTER forge_toolcall_passthrough.py, because it sends more
# turns through the exception that patch taught to carry the reasoning and the
# real finish_reason; it verifies that ordering and refuses to run otherwise.
# See patches/forge_empty_turn.py.
#
# Patch 9 finishes what patches 3 and 7 started, on the one path that matters
# most here. `_emit_text` routes four ways and its own docstring ended "The
# OpenAI SSE path is still the one place neither is carried" — neither the
# reasoning nor the backend's finish_reason — and OpenAI STREAMING is what pi
# uses for every turn. Measured against the live pair: llama-server reports
# finish_reason "length" for a request cut off at max_tokens, streaming and not;
# forge reported "stop". A turn that ran out of budget mid-sentence was therefore
# indistinguishable from one the model chose to end, which is exactly how the
# wedged turns above hid. See patches/forge_text_sse_passthrough.py.
#
# PATCH 10 — a backend read timeout on OpenAICompatClient.send_stream() returns
# a clean 408. send() converts httpx.ReadTimeout into BackendError(408);
# send_stream() never did, so a timeout mid-stream escaped raw and reached the
# client as "can only concatenate list (not 'str') to list" — the same
# uninterpretable string patch 1's bug produces, from an unrelated cause.
# Upstream antoinezambelli/forge#142, still open at 0.9.5.
# See patches/forge_stream_timeout.py.
#
# CORRECTION (2026-09-01). That patch's docstring claimed the streaming path is
# "the ONLY path that matters here". It is the one path that never runs, and the
# module is not the one this stack uses. A live traceback settled both:
# run_inference takes stream=False and handle_chat_completions never overrides
# it, so the backend call is always client.send(); and the client is
# LlamafileClient, not OpenAICompatClient. Patch 10 is kept — the hole it closes
# is real and upstream's issue is open — but it guards traffic this stack does
# not carry. PATCH 11 closes the same hole on llamafile.py, where the traffic
# actually is, for both send() and send_stream(). Without it a dead backend
# reached pi as "Stream ended without finish_reason", two hours after the fact.
# See patches/forge_llamafile_timeout.py.
#
# PATCH 12 makes a mid-stream failure VISIBLE. Once the 200 and the SSE headers
# are out the status line is spent, so the only way to report a backend fault is
# in the body — and forge's was unreadable in three separate ways. The message
# was str(exc), which for httpx.ReadTimeout is the empty string (forge's own log
# line, "<< ERROR:" with nothing after it, is the proof). It went out as
# {"error": ""}, and the OpenAI SDK's guard is `if (data && data.error) throw` —
# so an empty message defeated the one check that would have surfaced it. And
# nothing in the stream carried a finish_reason, which is the message the
# operator finally saw. Now: never an empty message, an error OBJECT rather than
# a bare string, and a terminal chunk with finish_reason "error" — deliberately
# NOT "stop", because patches 3, 8 and 9 all exist because a failure that ends
# the stream like a natural completion is invisible to everything above it.
# See patches/forge_sse_error_shape.py.
COPY patches/forge_merge_consecutive.py patches/forge_cached_tokens.py \
     patches/forge_reasoning_passthrough.py patches/forge_toolcall_content.py \
     patches/forge_merge_across_tools.py patches/forge_anthropic_reasoning.py \
     patches/forge_toolcall_passthrough.py patches/forge_empty_turn.py \
     patches/forge_text_sse_passthrough.py patches/forge_stream_timeout.py \
     patches/forge_llamafile_timeout.py patches/forge_sse_error_shape.py \
     /tmp/patches/
RUN SITE="$(python -c 'import site; print(site.getsitepackages()[0])')" \
    && python /tmp/patches/forge_merge_consecutive.py "$SITE" \
    && python /tmp/patches/forge_cached_tokens.py "$SITE" \
    && python /tmp/patches/forge_reasoning_passthrough.py "$SITE" \
    && python /tmp/patches/forge_toolcall_content.py "$SITE" \
    && python /tmp/patches/forge_merge_across_tools.py "$SITE" \
    && python /tmp/patches/forge_anthropic_reasoning.py "$SITE" \
    && python /tmp/patches/forge_toolcall_passthrough.py "$SITE" \
    && python /tmp/patches/forge_empty_turn.py "$SITE" \
    && python /tmp/patches/forge_text_sse_passthrough.py "$SITE" \
    && python /tmp/patches/forge_stream_timeout.py "$SITE" \
    && python /tmp/patches/forge_llamafile_timeout.py "$SITE" \
    && python /tmp/patches/forge_sse_error_shape.py "$SITE" \
    && rm -rf /tmp/patches

# Recorded in the image so `docker inspect` can answer "what is actually running"
# without cross-referencing .env.
LABEL org.opencontainers.image.title="instantcoffee proxy" \
      org.opencontainers.image.description="forge-guardrails proxy in front of llama-server" \
      forge.version="${FORGE_VERSION}"

# The helper scripts are COPIED, never bind-mounted. Docker Desktop resolves
# bind sources on the Windows side, so a WSL-style source path (which is what
# `./scripts` expands to here) mounts an EMPTY directory instead of failing —
# see context/design/decisions.md. Baking them in removes that whole class of
# bug and makes the image self-contained.
COPY --chown=forge:forge scripts/download_model.py scripts/smoke_test.py \
     scripts/bench.py scripts/bench_repeat.py scripts/bench_tools.py \
     scripts/bench_quality.py \
     scripts/ctx_needle.py scripts/ab_think_lang.py scripts/bench_literal.py \
     scripts/probe_lib.py scripts/capture_proxy.py scripts/capture_sessions.py \
     scripts/test_forge_patches.py /work/scripts/
# probe_lib.py is in that list even though nothing runs it directly: ctx_needle.py
# and bench_literal.py both import it, and a missing IMPORT fails at start-up with
# ModuleNotFoundError rather than with the "can't open file" that made the
# bench_quality.py omission below obvious.
#
# test_forge_patches.py is in the list because it can only run INSIDE this image:
# it imports the patched forge package and drives the patched functions. The
# patches already fail the BUILD if forge's source text moves, but that is a
# check on the input — a patch can apply cleanly to text that has shifted and
# produce a package that imports, serves, and returns the wrong field, which is
# the exact shape of every defect these patches exist to fix.
#
# bench_quality.py was MISSING from this list until 2026-08-23 while README.md
# documented a command that runs it, so that command failed with "can't open
# file" for anyone who tried it. An explicit COPY list silently omits new
# scripts; if you add one under scripts/ that is meant to run in the bench
# container, add it HERE too.

# System-prompt fragments. They have to be inside the image for the same reason
# the scripts are: neither llama-server nor forge can inject a system prompt, so
# the A/B harness applies it itself, and a bind-mounted source would resolve to
# an empty directory on Docker Desktop.
COPY --chown=forge:forge prompts/ /work/prompts/

WORKDIR /work
USER forge

EXPOSE 8081

# --host/--port are fixed here; everything else comes from the compose command.
#
# `python -m forge.proxy`, NOT the `forge-proxy` console script. forge 0.9.3
# removed that script from the PyPI package on purpose — its changelog: "The
# forge-guardrails Python package no longer creates a competing global command;
# Python-managed Proxy execution remains available through python -m forge.proxy,
# including in the Docker image" — so the standalone installer can own the name.
#
# This is not a cosmetic difference. On 0.9.0 through 0.9.2 the script exists and
# either form works; from 0.9.3 the container dies at start with
#     exec: "forge-proxy": executable file not found in $PATH
# which is a CONTAINER-INIT failure, not a Python error, so it produces no
# traceback and no forge log line — it looks like a broken image rather than a
# renamed entrypoint. Found exactly that way bumping 0.9.0 -> 0.9.5 on
# 2026-08-30; update.sh's smoke gate rolled it back.
#
# The module form works on every version this repo has run, so there is no
# version test here.
ENTRYPOINT ["python", "-m", "forge.proxy", "--host", "0.0.0.0", "--port", "8081"]
