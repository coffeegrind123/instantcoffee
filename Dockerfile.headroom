# headroom — context compression proxy, in front of forge.
#
# Built from PyPI rather than from a published image on purpose. GHCR carries
# only sha-<commit> tags for this project (checked: no semver tags at all), and
# a floating :latest is exactly what versions.lock exists to prevent. The PyPI
# release is the pinnable artifact, so this mirrors Dockerfile.forge.

FROM python:3.13-slim

ARG HEADROOM_VERSION
# Fail the build early and loudly rather than silently installing "latest".
RUN test -n "$HEADROOM_VERSION" || (echo "HEADROOM_VERSION build-arg is required" >&2; exit 1)

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # State (CCR cache, session stats, dashboard data) lives on the named
    # volume mounted here, so a restart does not lose a session's accounting.
    HOME=/home/headroom \
    HF_HOME=/home/headroom/.cache/huggingface \
    # This proxy has no internet job to do. The update check is a background
    # PyPI call the pins make meaningless, and telemetry is off by default —
    # both are set explicitly so neither depends on a default staying put.
    HEADROOM_UPDATE_CHECK=off \
    HEADROOM_TELEMETRY=off

# python:3.13 and not 3.14: headroom's core depends on litellm, which declares
# python_full_version < "3.14". That is also the interpreter its own docs point
# at for the dashboard's cost figures.
#
# [proxy] and [code], deliberately NOT [all] or [ml]:
#   [ml] pulls torch>=2.12 for the Kompress-v2-base text model. On this box the
#   GPU is entirely committed to a 27B in the neighbouring container, so a
#   multi-GB torch install would buy a compressor that has nowhere to run. The
#   compression that pays for itself in an agent loop — JSON tool output, logs,
#   build spew — is SmartCrusher and format-native compaction, neither of which
#   needs torch. onnxruntime and transformers already come in with [proxy] for
#   the content-detection paths.
#   Add "headroom-ai[ml]==${HEADROOM_VERSION}" here if you later want Kompress
#   prose compression and have measured that it is worth the image size.
#
# [code] is tree-sitter only (~2 MB) and enables the AST-aware compressor for
# code in the live zone.
RUN pip install --no-cache-dir \
        "headroom-ai[proxy,code]==${HEADROOM_VERSION}" \
    && useradd --create-home --uid 1000 --home-dir /home/headroom headroom \
    && mkdir -p /home/headroom/.headroom \
    && chown -R headroom:headroom /home/headroom

LABEL org.opencontainers.image.title="qwen3.6-forge headroom" \
      org.opencontainers.image.description="headroom compression proxy in front of forge" \
      headroom.version="${HEADROOM_VERSION}"

# COPIED, never bind-mounted — Docker Desktop resolves bind sources on the
# Windows side and a WSL-style source silently mounts an empty directory.
# Same reasoning as Dockerfile.forge.
COPY --chown=headroom:headroom scripts/headroom-entrypoint.sh /usr/local/bin/headroom-entrypoint.sh
RUN chmod +x /usr/local/bin/headroom-entrypoint.sh

WORKDIR /home/headroom
USER headroom

EXPOSE 8787

# --host/--port are fixed by the entrypoint; everything else comes from the
# compose command and from HEADROOM_RECOVERY / HEADROOM_TARGET_RATIO.
ENTRYPOINT ["/usr/local/bin/headroom-entrypoint.sh"]
