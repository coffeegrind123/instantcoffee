##############################################################################
# instantcoffee — single source of truth for the whole stack.
#
# This file is COMMITTED on purpose: the pins below are what make the setup
# reproducible. It contains no secrets.
#
# For machine-local overrides that should NOT be committed, create .env.local
# (gitignored) with the same keys — the scripts merge it on top of this file.
# The Anthropic API key is the one secret this stack has, and it lives there.
##############################################################################

# ---------------------------------------------------------------------------
# Anthropic — the hosted models. This branch runs no local inference.
# ---------------------------------------------------------------------------
# The three seats this branch runs. One model per seat, and the seats are the
# whole design: the session that plans and verifies, the workers, and one
# advisor that is only ever asked to think.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_SUBAGENT_MODEL=claude-haiku-5-5
ANTHROPIC_ADVISOR_MODEL=claude-fable-5-1
#
# The key itself is NOT here, and must not be. This file is tracked; the
# credential is a secret, so it lives in .env.local (gitignored) and nowhere
# else. pi-local.sh refuses to launch without it and never writes it into
# models.json — the generated file names the variable, not the value.
# .env.local.example says where to get one.

# ---------------------------------------------------------------------------
# pi's prompt-cache policy.
# ---------------------------------------------------------------------------
# Every turn re-sends the conversation, so the cache is the difference between
# a session that costs dollars and one that costs cents — and it is the only
# reason a 1,000,000-token window is usable at all. The two tiers are
# Anthropic's own, and pi warms a prefix ONLY for a model that declares a
# lifetime, so these numbers are the switch the whole caching story hangs off
# rather than tuning.
PI_CONTEXT_WINDOW=1000000
PI_CACHE_SHORT_SECONDS=300
PI_CACHE_LONG_SECONDS=3600
# streaming | idle. `idle` also warms between runs, which is what a session
# with long gaps between turns actually needs; pi still refuses to warm unless
# the avoided cache-miss cost beats its own floor.
PI_CACHE_WARMING=idle
# On, because the whole point of paying for cache writes is knowing when they
# are being thrown away.
PI_SHOW_CACHE_MISS_NOTICES=1
# short | long — which tier's breakpoints pi puts on the wire. This is pi's own
# variable, not a provider field, so it is exported rather than written into
# models.json.
PI_CACHE_RETENTION=long
# Refresh pi's model catalog at launch. The catalog bundled with the installed
# pi lags the published one, and a seat the catalog does not know silently
# falls back to the parent's model — the one failure this branch exists to
# prevent. Fails soft: a registry round trip never blocks a session.
PI_UPDATE_MODELS_ON_LAUNCH=1

# Where pi's OWN compaction fires, as a fraction of PI_CONTEXT_WINDOW — 0.28 of
# 1M is the 280,000 this branch targets. A 1M window is a ceiling, not a working
# size: the prefix cost, the cache-miss blast radius and what the model actually
# attends to all grow with it, and pi's built-in numbers (reserveTokens 16384,
# keepRecentTokens 20000) were sized for a 200k window. See the block in
# scripts/pi-local.sh that writes them, including why they are set per model.
#
# Note the direction: pi triggers at `window - reserveTokens`, so a LARGER
# PI_COMPACTION_AT_PCT compacts EARLIER.
PI_COMPACTION_AT_PCT=0.28
# How much transcript survives a compaction verbatim. 0.15 is 150,000 — 54% of
# the trigger above, so each compaction frees ~130,000. Watch it against
# /session's reported usage before trusting the pair; a large verbatim tail is
# what a long agentic session wants and also what it pays for every turn.
PI_COMPACTION_KEEP_PCT=0.15

# ---------------------------------------------------------------------------
# Measurement — what verifies this branch.
#
# No eval harness, no throughput bench, no A/B script: all three measured a
# local model and went with it. What is left is `pi --list-models` for the
# catalog and the credential, the extension unit tests in
# vendor/pi-subagents-lite/tests/, and a first real session.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps the one published port host-only — the observe dashboard
# below. Use 0.0.0.0 to expose on the LAN.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# pi session transcripts, as the HOST sees them.
# ---------------------------------------------------------------------------
# Read by Dockerfile.pi's entrypoint, which prints this on every container start
# and warns when it is unset: the container cannot derive a host path from its
# own HOME, and a stale one fails as a FileNotFoundError on a path that plainly
# exists. It has to be the WINDOWS-side path, for the same reason
# PI_CONTAINER_HOME_HOST does — a WSL-style source silently mounts an EMPTY
# directory on Docker Desktop rather than failing. Here ~/ is a 9p mount of
# C:\users\user\downloads\as\data, so ~/.pi/agent/sessions is the path below.
# Machine-specific, so an operator override belongs in .env.local; the value
# here is the one this branch was built against. Change it if
# PI_CODING_AGENT_DIR moves pi's agent directory.
PI_SESSIONS_DIR=//c/users/user/downloads/as/data/.pi/agent/sessions

# ---------------------------------------------------------------------------
# pi (scripts/pi-local.sh) — the only client this stack targets.
# ---------------------------------------------------------------------------
# 1 loads the project's AGENTS.md / CLAUDE.md; 0 passes -nc, which skips that
# discovery entirely.
#
# ON by default. It was off to save window, and that was the wrong trade: a
# coding agent that ignores the conventions file sitting in the repo it is
# editing produces work you then have to correct by hand, which costs far more
# than the tokens. pi walks parent directories to find them, so the cost scales
# with how much you have written down, not with the size of the repo.
#
# Set to 0 for a session where the window matters more than the conventions —
# a long single-file refactor, or a project whose AGENTS.md is enormous.
PI_CONTEXT_FILES=1
# Shell aliases do NOT apply inside scripts — bash only expands them in
# interactive shells. Anything your own `pi` alias adds has to be repeated here
# or pi-local.sh launches without it. --print-only shows what will actually run.
PI_EXTRA_ARGS=

# Keep pi on the current npm release. pi ships often and this stack is only ever
# tested against the latest, so the launcher checks and upgrades in place.
#
# Rate-limited by a stamp file rather than checked every launch — a registry
# round trip per session is latency you would feel, and the launch already has
# an upgrade to get on with. The check fails soft in every direction: no npm, no
# network, or a failed install all warn and launch on what is already there.
# Set PI_AUTO_UPDATE=0 to pin whatever version you have.
PI_AUTO_UPDATE=1
PI_UPDATE_INTERVAL_H=24

# ---------------------------------------------------------------------------
# pi in a container (scripts/pi-container.sh + Dockerfile.pi)
#
# Optional, and off unless PI_CONTAINER_HOME_HOST is set. It gives a pi session
# a home directory of its own, with the browser stack in the same image, and is
# otherwise identical: pi-container.sh delegates to pi-local.sh inside, so the
# flags, the banner and the session are the same ones. docs/container.md.
#
# The container is long-lived and reused rather than created per session, on
# purpose: the browser server and its Chrome live in it and are stateful.
# ---------------------------------------------------------------------------
# REQUIRED to use it, and the one thing that cannot be defaulted: the agent's
# home directory AS THE DOCKER DAEMON SEES IT. This shell cannot derive it —
# the daemon resolves bind sources, not the caller — and on Docker Desktop it
# must be docker's form of the Windows path (//c/path/to/pi-home). A WSL-style
# source silently mounts an EMPTY directory rather than failing, which arrives
# as "my home is gone" instead of as a bad path. Same rule as PI_SESSIONS_DIR.
#
# Machine-specific by nature, so set it in .env.local rather than here.
PI_CONTAINER_HOME_HOST=
# Where that directory appears inside the container. Only change it if you also
# change the Dockerfile — pi-container.sh maps host paths onto it.
PI_CONTAINER_HOME=/home/piuser
# The checkout pi-container.sh delegates to, inside the container. It lives on
# the mount above, so this is a path in the agent's own home.
PI_CONTAINER_REPO=/home/piuser/instantcoffee
PI_CONTAINER_IMAGE=pi-agent:latest
PI_CONTAINER_NAME=instantcoffee-pi
# Chrome. The default 64 MB /dev/shm kills renderer processes under memory
# pressure, which surfaces as pages that half-load and navigate calls that time
# out — i.e. as "the browser is broken" rather than as a container limit.
PI_CONTAINER_SHM=2g
# Seconds to wait for the container to report ready on first create. The first
# start installs pi-mcp-adapter over the network; later starts are seconds.
PI_CONTAINER_READY_TIMEOUT=300
# Extra `docker run` flags, split on whitespace. For a second mount, a memory
# cap, a network — anything this file has no opinion about.
PI_CONTAINER_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# MCP, without MCP (scripts/mcp.sh + skills/mcp-tools)
#
# pi has no MCP support and this stack does not want it — one server can publish
# hundreds of tool schemas into the window before the first message, and every
# one of them is billed on every turn thereafter. mcp2cli turns an MCP server
# into a CLI instead, so a schema costs tokens only at the moment the model
# decides to use that one tool.
#
# 1 loads skills/mcp-tools into the session, which is what teaches the model
# that ./scripts/mcp.sh exists. Only the skill's name and description sit in the
# prompt (~60 tokens); pi loads the body on demand. Servers are declared in
# mcp/servers.json.
#
# ON by default. The cost is bounded and known — ~60 tokens of skill description
# per session, and nothing else until the model chooses to call a server — so
# there is no measurement standing between it and being useful. Needs uv on
# PATH; the first call installs the pinned mcp2cli.
# ---------------------------------------------------------------------------
MCP2CLI_ENABLED=1
MCP2CLI_VERSION=3.3.1
# Load-bearing pin, not caution. mcp2cli 3.3.1 reads `Tool.inputSchema`; the MCP
# Python SDK renamed it to `input_schema` in 2.0.0, so an unpinned install
# resolves 2.0.0 and every MCP call dies with AttributeError before reaching the
# server. Verified both ways on 2026-08-12. Raise this only once mcp2cli
# supports SDK 2.x.
MCP_SDK_VERSION=1.29.0


# ---------------------------------------------------------------------------
# Browser (scripts/browser.sh + skills/browser)
#
# A real Chrome, driven over CDP by the Zendriver MCP server. Not routed through
# scripts/mcp.sh, for two measured reasons (2026-08-16):
#
#   1. mcp2cli spawns the server per call and its session daemon does not work
#      here, so every call would get a FRESH Chrome — `navigate` would open a
#      page that the next command could never see. browser.sh instead starts the
#      server ONCE over HTTP and every call reaches that one process.
#   2. One mcp2cli invocation costs 11-43 s on this box; one direct tools/call
#      POST costs 24 ms. A browser task is 20+ calls.
#
# 1 loads skills/browser into the session (~120 tokens of name and description;
# pi loads the body only when a task matches). The server itself starts on first
# use and stops with `./scripts/browser.sh down`, so nothing runs until asked.
# ---------------------------------------------------------------------------
BROWSER_MCP_ENABLED=1
# Checkout of https://github.com/coffeegrind123/Zendriver-MCP-fork. NOT vendored:
# it pulls zendriver plus a Chrome, which has no business inside this repo.
# Empty falls back to /opt/zendriver-mcp, then ~/Zendriver-MCP.
ZENDRIVER_MCP_DIR=/opt/zendriver-mcp
BROWSER_MCP_HOST=127.0.0.1
BROWSER_MCP_PORT=8931
# Chrome needs an X display even when nothing looks at it. The container runs
# Xvfb on :99; on a desktop, leave this empty to inherit the session's DISPLAY.
BROWSER_MCP_DISPLAY=:99
# 1 lets a tool call start the server (and open a browser) by itself. 0 makes
# both explicit, which is what you want if a stray call must never launch Chrome.
BROWSER_MCP_AUTOSTART=1
# Seconds a single tool call may take, as seen by the CLI (scripts/browser.sh).
# Page loads behind a challenge, lighthouse runs and screencast exports are the
# slow ones, and the CLI is driven by a human who can wait.
BROWSER_MCP_TIMEOUT=180

# Seconds a single tool call may take INSIDE THE SERVER, which is a different
# question and has to be answered against the client that is waiting.
#
# The server has always guarded its own calls (ToolBase._register wraps every
# tool in asyncio.wait_for, 120s by default), but pi's adapter gives up at
# requestTimeoutMs = 30000. The server therefore lost the race every time: it
# kept working for up to 120s while the model had already been handed
# "Failed to call tool: Request timed out" plus a dump of the tool's parameters
# — which names nothing about the browser and reads as a bad argument.
#
# Observed 2026-08-17: navigate to a URL whose page.get() never returns, then
# every following call timing out the same way, and the model concluding the
# browser was broken and falling back to curl. The page had in fact loaded.
#
# Sized BELOW the adapter's 30s so the server always answers first, with a real
# sentence ("Tool 'navigate' exceeded its 25s time budget") that says which tool
# and how long. Raise the adapter's requestTimeoutMs too if you raise this.
BROWSER_MCP_TOOL_TIMEOUT=25


# ---------------------------------------------------------------------------
# The browser as native pi tools (pi-mcp-adapter)
#
# The hybrid: scripts/browser.sh still OWNS the server process — it outlives a
# pi session and is shared with anything else on the box — while pi reaches it
# through pi-mcp-adapter instead of shelling out to the CLI. The model then calls
# navigate/click/type_text/get_interaction_tree/get_text_content as ordinary
# tools, and the other 93 stay one mcp({ search }) away.
#
# Measured on 2026-08-16, against this stack's own server, from the bytes pi
# actually sent to a stub model:
#   context   720 tokens for the mcp proxy tool, 302 for mcpScript, 1,155 for
#             the five direct tools = 2,178, against a 1,000,000-token window
#             (0.22%) — but paid on every turn. Loading all 98 schemas the
#             normal MCP way would be ~19k (1.9%).
#   latency   25-417 ms per call, in-process, against 1.7-6.5 s for the CLI
#             (which pays a Python start and a full tools/list every call) and
#             11-60 s for mcp2cli.
#   batching  mcpScript runs a whole flow — navigate, read, click, read — in ONE
#             tool call, which is worth more than the tokens it costs.
#
# 0 falls back to the CLI path: skills/browser and ./scripts/browser.sh, which
# needs no npm package and stays the answer for a shell, a script, or a human.
#
# The package is NOT vendored — 42 dependencies and 83 MB installed is not
# something this repo can carry the way it carries the /loop fork. pi-local.sh
# checks it and prints the install command rather than installing it silently:
#   pi install npm:pi-mcp-adapter@2.26.0
# ---------------------------------------------------------------------------
MCP_ADAPTER_ENABLED=1
# Pinned, and checked at launch. The adapter is a fast-moving package (2.26.0 was
# published the day before this was wired up); a surprise major would change the
# tool surface the model has been taught, mid-session.
MCP_ADAPTER_VERSION=2.26.0
# 1 starts the browser SERVER at launch when the adapter is on (~2 s, ~50 MB, no
# Chrome until a tool asks for one). Without it the model's first browser call
# hits a closed port, and a model that reads that as "the web is not available
# to me" stops trying for the rest of the session. Chrome still only launches on
# demand, and ./scripts/browser.sh down still stops everything.
BROWSER_MCP_AUTOUP=1


# ---------------------------------------------------------------------------
# pi packages
# ---------------------------------------------------------------------------
# Unattended loop mode: `/loop start <goal>` iterates the agent until you stop
# it. NOT an npm install any more — scripts/pi-local.sh loads the fork in
# vendor/pi-loop-mode by absolute path, so the loop behaves the same in whatever
# directory pi was started in and the fixes travel with this checkout.
#
# If the upstream package is still in pi's user settings from before the fork,
# remove it: `pi uninstall npm:pi-loop-mode`. Two copies register two /loop
# commands that fight over the same session state; pi-local.sh warns about it.
#
# Chosen over pi-agent-loop after testing both: this one persists loop state as
# session entries and rebuilds context locally on overflow, so a loop survives
# compaction, and its repetition/degenerate-output handling is aimed squarely at
# a model that loops on a stuck tool call. Verified end to end — see
# context/design/decisions.md and vendor/pi-loop-mode/FORK.md.
#
# May the MODEL arm a goal check by itself? 0 (unset) = ask, 1 = yes.
#
# `/loop start … --check "CMD"` runs CMD with `bash -lc` once per iteration, for
# the life of the run and across `/loop resume`. That is the one shell channel in
# this stack that emits no `tool_call`, so the Matrix permission relay, rtk-pi's
# gate and the compaction guard's output cap never see it — which is why
# `--check` is refused from Matrix (AD6).
#
# The `loop` TOOL declares the same parameter, and a tool's caller is the model,
# whose instructions can come from a file it read or from a Matrix message the
# same stack calls untrusted input. So by default the operator is TOLD the model
# asked, and ASKED to confirm it when there is anybody to ask; with nobody to ask
# (pi -p, cron) the check is not armed and the loop starts without one, which
# `until_done` handles on the LOOP_DONE marker as it always has.
#
# Set to 1 for an unattended run that genuinely wants the model arming its own
# check. Your own `/loop start --check` in the terminal is unaffected either way:
# that is you choosing the command. See AJ2 in
# context/design/subagents-loop-verifier-authority.md.
LOOP_TOOL_CHECK=0

# Recorded for provenance: the upstream release this fork started from.
PI_LOOP_MODE_VERSION=2.5.4

# ---------------------------------------------------------------------------
# Subagents (vendor/pi-subagents-lite)
#
# Delegate a job to a focused child session that burns its OWN window and hands
# back a bounded summary. pi ships no subagents on purpose ("ask pi to build what
# you want or install a third party pi package"), so this is a vendored fork —
# see vendor/pi-subagents-lite/FORK.md for what was changed and why.
#
# ON by default. It is not free — a registered tool costs its schema on every
# turn whether or not the model ever calls it — but the bill was measured rather
# than feared: 710 chars, ~178 tokens for all three tools — that was 0.54% of
# the 32k window the fork was built against, and 0.018% of this branch's
# 1,000,000. For scale, the six prinny tools cost ~1,470 before they were folded
# into one. Set this to 0 to get those 178 tokens back.
#
# Note what a subagent buys HERE. On the local branch it was not parallelism —
# one llama slot meant concurrent children queued wherever the queue formed.
# With the hosted API the concurrency is real (SUBAGENT_MAX_CONCURRENT below),
# but the reason to delegate is still context isolation: the noisy search
# happens in someone else's window and the parent reads a bounded summary.
#
# The cost that actually matters is not the tool schema, it is the spend. Every
# child turn is billed, and a child that reads files and grows to ~18k tokens
# pays that twice — once to build the context and once to judge the answer —
# while its work never appears in the parent's prefix cache. Delegate work worth
# a brief; do not delegate a lookup.
SUBAGENTS_ENABLED=1

# What a subagent loads that it could not otherwise reach.
#
# A child does not inherit the parent's -e flags: it discovers its own
# extensions, so everything in .pi/extensions/ (the compaction guard, /stack,
# the browser guard) reaches it and everything in vendor/ does not. Measured on
# a live subagent: 12 tools, one skill, nothing from vendor/.
#
# Unset means the fork's default — vendor/pi-loop-mode and vendor/rtk-pi. loop
# because a bounded goal loop belongs in a window that is not the operator's;
# rtk because a child running bash uncompressed is the session that can least
# afford it. Set this to a comma- or colon-separated list of absolute paths to
# replace that default, or to the empty string for none.
#
# vendor/prinny-channel is denied unconditionally and cannot be added here: a
# subagent is spawned by the model, with a prompt you never see, and it does not
# get to post to a Matrix room. Its two skills are denied with it.
#SUBAGENT_EXTRA_EXTENSIONS=

# Check a subagent's answer against the task before the parent reads it.
#
# ON unless set to 0. Three layers, cheapest first, so most runs pay nothing
# extra: the task is restated into the child's context after each compaction
# (free, and the layer that matters most — it stops the drift instead of
# catching it); an empty answer or a run that hit the turn ceiling is handled
# without a model call; and only a non-empty answer from a clean run is worth
# asking a judge about, because that is the only case where drift is invisible.
#
# The judge is a fresh one-turn agent with no tools that sees ONLY the task and
# the answer. Not the child itself: a model shown its own reasoning ratifies its
# own answer, so the judge is made harder to fool by knowing less. A failed
# verdict continues the CHILD, since that is where the context to fix it is, and
# the fix is then re-judged.
#
# It costs nothing in schema — the verifier agent is hidden from the Agent
# tool's type list, measured — but a judged answer does cost one small model
# call while the parent's Agent tool call is blocked. Set to 0 to skip it.
SUBAGENT_VERIFY=1

# How many times a wrong answer may be sent back to the child.
#
# A round is a repair plus the re-check that follows it: two billed model calls
# while the parent is blocked, and two more turns in a child window that is
# already the thing most likely to be at fault. So the worst case is 1 +
# 2*ROUNDS calls for a single subagent answer.
#
# The loop also stops early on an empty repair and on a repair identical to the
# answer just rejected — a child that repeats itself has nothing more to give,
# and another round would buy the same verdict at full price.
#
# 0 checks but never repairs (report-only). Values above 3 are clamped: past
# that the honest fix is a narrower task, not a more insistent verifier.
# Unset or unreadable falls back to 1 rather than 0, so a typo cannot silently
# turn the repair off in a way that looks like everything passing.
SUBAGENT_VERIFY_ROUNDS=1

# How long one verification model call may take before it is abandoned, in ms.
#
# There has to be a number, because nothing else can end these calls.
# Verification runs inside the settlement chain, AFTER the child's status has
# gone terminal — and every stop path in the manager keys off "running". So
# while a judge or a repair is in flight the operator's Esc reaches abort() and
# does nothing, the StopAgent tool likewise, and the watchdog drops the record's
# state rather than watching it. The parent's Agent tool call is meanwhile
# blocked until verification returns. A stalled provider request therefore hung
# the parent with no way out but killing pi.
#
# 300000 (5 min) is long enough that a slow but working answer is never cut off
# and short enough that a stall is a pause, not a hang. A timeout surfaces as the
# verifier's "errored" verdict: the answer still goes out, annotated as
# unchecked. There is no way to spell "no deadline" — 0 clamps to the 10s floor,
# because a disabled deadline is indistinguishable from the bug it prevents.
SUBAGENT_VERIFY_TIMEOUT_MS=300000

# A subagent's own turns in the operator's session transcript. Default on.
#
# One entry per child TURN, marked `subagent <id> <type> · turn N`, bounded at
# 60 entries per delegation and 4,000 characters each. It costs the MODEL
# nothing on any turn — pi's `sessionEntryToContextMessages` returns [] for a
# `type: "custom"` entry, so it persists and renders and is never context — but
# it does cost bytes in the session file, and an unattended /loop that delegates
# every iteration writes a lot of them.
#
# Set to 0 to write nothing. (Twenty-third pass, AN4: this line reached the
# process for the first time when `scripts/pi-local.sh` began forwarding it.)
#SUBAGENT_TRANSCRIPT=0

# The judge's raw prompt and reply, one JSONL line per verifier model call, in
# ~/.pi/agent/subagent-verify.jsonl. Default on.
#
# It is the file that makes a claim about how a verdict was PARSED checkable: a
# reply and the parse beside it is the only thing that can show the parser was
# wrong, and four findings in this series each needed one. Bounded at 2,000
# lines, newest kept, 4,000 characters per field.
#
# Set to 0 to write nothing; SUBAGENT_VERIFY_LOG_FILE moves it. (AN4: neither
# was forwarded before the twenty-third pass.)
#SUBAGENT_VERIFY_LOG=0
#SUBAGENT_VERIFY_LOG_FILE=

# Recorded for provenance: the upstream release this fork started from.
PI_SUBAGENTS_LITE_VERSION=1.11.0

# Tell the model to USE the subagents it already has.
#
# 1 = append prompts/delegate.md to the system prompt; 0 = do not. Inert unless
# SUBAGENTS_ENABLED=1, because a fragment describing a tool that is not
# registered is worse than nothing.
#
# WHY THIS EXISTS. The capability was never the problem — FORK.md's live run
# against this model records it emitting "a well-formed Agent call with a
# self-contained prompt and a sensible description, did not search itself, and
# got a correct answer back", and inferring run_in_background and AgentStatus
# from parameter names alone. It delegates well WHEN ASKED. Nothing in the
# session ever asked. The Agent tool carries no description on purpose (upstream
# deletes it to save tokens; see FORK.md), so the only thing advertising
# delegation was the word "Agent" and an enum listing general-purpose,Explore.
#
# WHY A PROMPT FRAGMENT AND NOT AN AGENT TYPE. A custom type in
# ~/.pi/agent/agents/ would auto-populate that enum for the cost of its name
# alone (registration.ts:33 builds the schema as `types.join(",")`, so the
# frontmatter description never reaches the wire). That is genuinely cheap — but
# `Explore` is ALREADY a built-in, and already in the enum, and its own one-line
# summary is "Explore codebase architecture". A codebase-research type would
# duplicate a built-in. The menu was never missing; the instruction to look at
# it was.
#
# THE FRAGMENT ARGUES BOTH WAYS ON PURPOSE, and that is the part not to edit out
# casually. Measured in FORK.md on the local branch: a small child left the
# parent's prefix cache at 99.2%, but one that actually read files and grew to
# ~18k tokens evicted it, and the parent's next call re-paid for the whole
# prefix — 442 ms to 2,949 ms on a 2,133-token parent, a floor and not a worst
# case. Here the mechanism is the same in cache-miss spend instead of
# milliseconds. So a nudge that simply said "delegate more" would trade cheap
# reads for cache misses. delegate.md therefore carries the threshold (~five
# file reads or three searches) as well as the encouragement.
#
# ~433 tokens, every turn, against a 1,000,000-token window. For scale
# prompts/web-untrusted.md is ~460 and the whole three-tool subagent schema is
# ~178.
#
# UNMEASURED. This is a behavioural prompt change adopted ahead of evidence,
# which is the footing prompts/README.md calls out. What it should move is
# turns-per-session and how far a task gets before the window fills — not
# correctness. Set to 0 for the control arm.
SUBAGENT_NUDGE=1

# Orchestrator mode — this seat plans and verifies, the workers execute.
#
# ORCHESTRATOR=1 turns the session into an orchestrator-worker loop: this model
# plans, writes briefs, re-runs every check a subagent claims and keeps a
# durable board (.pi/orchestrator/ in the project); up to
# SUBAGENT_MAX_CONCURRENT children run on SUBAGENT_MODEL in parallel. The
# orchestrator prompt is prompts/orchestrator/main.md, the child types
# prompts/orchestrator/agents/, and the one advisor seat runs on ADVISOR_MODEL.
# Needs SUBAGENTS_ENABLED=1 and ANTHROPIC_API_KEY in .env.local. See
# docs/orchestrator.md.
#
# Pi-side only: nothing here touches the container stack, so there is nothing
# to restart. Replaces the delegation nudge above for the session (it says the
# opposite).
#
# DATA LEAVES THE MACHINE. Everything a child reads is sent to SUBAGENT_MODEL's
# provider. The answer judge (SUBAGENT_VERIFY) is OFF in this mode whatever it
# says above: the orchestrator re-runs every claimed check itself.
ORCHESTRATOR=1
# The child model the orchestrator seeds, and the advisor's. pi resolves these
# as provider/model-id, so the provider prefix is part of the value.
SUBAGENT_MODEL=anthropic/claude-haiku-5-5
ADVISOR_MODEL=anthropic/claude-fable-5-1
# Children running at once, 1-15, PER LEVEL. Excess spawns queue.
SUBAGENT_MAX_CONCURRENT=15
# How deep delegation goes. 1 = only the session spawns; 2 = its children may
# spawn helpers (through a SubAgent tool; foreground, one level only). Empty =
# 1 normally, 2 in orchestrator mode. Each level has its own pool of
# SUBAGENT_MAX_CONCURRENT, so at depth 2 up to 2x that many calls can be live.
SUBAGENT_MAX_DEPTH=

# ---------------------------------------------------------------------------
# Matrix channel (vendor/prinny-channel)
#
# Talk to a pi session from any Matrix client. A message from an allowlisted
# sender becomes a turn; the answer is forwarded back automatically, which is
# the point: the model writes its answer into the transcript instead of calling
# a reply tool, and with the upstream Claude Code design that answer reached
# nobody.
#
# OFF by default, and deliberately so. This is the only thing in this stack that
# logs into a remote service and makes the session addressable from the
# internet — that is a decision to take on purpose, not a default to inherit.
# 0 leaves the extension out of the session entirely rather than loading it in a
# dormant state, so there is nothing to misconfigure until you ask for it.
#
# Turning it on:
#   PRINNY_ENABLED=1, then in a pi session:
#     /prinny prepare                                    once, ~1 min
#     /prinny configure https://server @bot:server pass
#     (message the bot from your client, it replies with a code)
#     /prinny pair <code>
#     /prinny policy allowlist                           lock it down
#
# Credentials live in ~/.pi/agent/channels/prinny/.env, mode 600 — NOT here.
# This file is committed; that one is not, and is written by /prinny configure.
#
# One Matrix account per channel. Two bots on one account duplicate every
# delivery and fight over the crypto store. See vendor/prinny-channel/FORK.md.
#
# It is also not free to have loaded, though that argument is much weaker than
# it was. Measured 2026-08-16 off the wire, the six prinny_* tool schemas were
# 1,470 tokens, spent every turn before the model read a word. Re-measured
# 2026-08-17 with the same harness after the six were folded into one `prinny`
# tool dispatching on `action`: the channel's whole tool surface is 1,333 chars,
# ~333 tokens. The inbound wrapper went the same way — a message is now
# `[matrix] <text>` rather than a fourteen-attribute <channel> block, 38 chars
# where it was 249.
#
# So the remaining reason to leave this at 0 is the EXPOSURE, not the cost: it
# logs a bot into a homeserver and makes the session addressable from the
# internet. Turn it on when you are using Matrix, not by default.
# ---------------------------------------------------------------------------
PRINNY_ENABLED=0

# ---------------------------------------------------------------------------
# Bash output compression (scripts/rtk.sh + vendor/rtk-pi)
#
# Same arithmetic as the MCP block above, pointed at the other big consumer of
# the window. Bash output is a token nobody chose to send: every byte of pytest
# chatter is a byte that is not the file the model was asked to read, and with
# the model hosted it is billed like any other. rtk filters a command's output
# before pi ever sees it — `git status` 275 -> 49 bytes, `pytest -q` on 43 tests
# 1312 -> 476, both measured in this repo on 2026-08-16.
#
# 1 loads vendor/rtk-pi into the session. Without the binary on PATH the
# extension warns once and filters nothing, so this is safe to leave on before
# `./scripts/rtk.sh --install` has ever been run.
#
# It filters an ALLOW-LIST, not everything. Upstream's extension hands every bash
# command to rtk; this fork does not, because some rewrites substitute a
# different command — `npm run lint` becomes a bare eslint, `uv run pytest`
# resolves a pytest outside the venv — and because most other filters save
# nothing here anyway. Read vendor/rtk-pi/FORK.md before widening it, and
# re-measure with `./scripts/rtk.sh --check` after changing the pin.
#
# RTK_DISABLED=1 in the environment turns filtering off for one launch without
# editing this file.
# ---------------------------------------------------------------------------
RTK_ENABLED=1
# Pinned deliberately. rtk shipped 45 minor versions in seven months and its
# filters are what the allow-list is trusting; an unpinned filter set can change
# what a command reports between two sessions with nothing in the checkout to
# show for it. Raise it, then run ./scripts/rtk.sh --check before committing.
RTK_VERSION=0.45.0

# --- persona ----------------------------------------------------------------
# /persona — a character persona over invariant engineering. A port of
# openclaude's /identity system; see vendor/pi-persona/FORK.md for provenance,
# the six departures from upstream, and the wire measurements.
#
# ON by default, and the cost of that is zero: with no persona active the
# extension adds no system prompt and registers no tool, so a session that never
# runs /persona pays nothing for having it loaded. Measured on pi 0.84.4 by
# capturing a real POST /v1/chat/completions, not estimated.
#
# The cost appears once a persona IS active, and then it is the largest single
# thing in the request:
#
#     pi's own system prompt (4 tools)     2,590 B      ~648 tok
#     <active_persona>, full              14,729 B    ~3,683 tok
#     <active_persona>, lean               9,243 B    ~2,311 tok
#
# It is byte-stable across turns, so it costs one cache write at activation and
# is cached after. /persona status prints the live number.
#
# What the persona has authority over is VOICE. It has none over thoroughness,
# investigation depth, tool choice, code quality, test coverage, or honesty
# about results — that is written into the block itself rather than left as a
# hope, because a "lazy" character that actually reads fewer files is a worse
# agent wearing a costume.
PERSONA_ENABLED=1

# full | lean. `full` is the faithful port. `lean` drops the four
# roleplay-specific enumerations (content allowance, third-person story framing,
# tease-deny, hedge patterns 5 and 7) and keeps every rule that fires on
# ordinary engineering work — the fourth wall, no simulated tool output, the
# assistant-framing ban, and engineering-invariance. ~1,372 tokens cheaper per
# request. Change it for one launch with PERSONA_PROMPT_MODE=lean ./scripts/pi-local.sh
PERSONA_PROMPT_MODE=full

# immersion | analysis | off — the first-user-message thinking-mode marker,
# ~120 tokens appended once to the first message of a session. It re-routes the
# model's <think> from "deliberate about the character from outside it" to
# "think as them".
#
#   immersion   in-character first-person inner monologue in <think> (default)
#   analysis    the same re-routing, but a clean planning trace instead of an
#               inner monologue. Better on a long engineering task, where the
#               bracketed internal monologue is noise.
#   off         nothing appended
#
# It originated as a DeepSeek-V4 training artefact and this stack gated on that
# until 2026-08-30, which was wrong: it confused "was this trained in" with
# "will this be followed". The markers are also an ordinary instruction, and the
# failure they fix was then watched happening here with a persona active — the
# model reasoning "the user is asking me to participate — Crystal is an AI
# assistant" instead of thinking as Crystal. See vendor/pi-persona/FORK.md §5.
#
# Still UNMEASURED: on because the failure was observed and the fix is cheap,
# not because a benchmark said so. /persona immersion off is one command.
PERSONA_IMMERSION=immersion

# --- observe ----------------------------------------------------------------
# Stream every session to instantcoffee-observe, the dashboard for this stack
# (https://github.com/coffeegrind123/instantcoffee-observe): prompts, tool calls
# and results, LLM generations with tokens and timing, compactions, and each
# subagent under the Agent call that spawned it. Its own llama and forge pollers
# went with the local model and are pinned off in docker-compose.yml.
#
# On by default because it costs nothing in the window (it registers no tools)
# and nothing when the dashboard is down (one failed request per ten seconds,
# never a stalled turn). The launch banner says whether it was reachable, and
# /observe inside pi shows what was sent and dropped.
OBSERVE_ENABLED=1

# Where the dashboard listens. Empty = http://127.0.0.1:<OBSERVE_PORT>, or
# host.docker.internal on that port when pi itself runs in a container.
OBSERVE_URL=

# Groups every session under this one project in the dashboard, instead of the
# project it derives from each session's working directory.
#OBSERVE_PROJECT_SLUG=

# The dashboard itself is the `observe` service in docker-compose.yml, built
# from the vendor/instantcoffee-observe submodule — the only service the stack
# has left. Everything below is optional.
#
# Published on BIND_ADDR, the only published port here. pi-local.sh's default
# OBSERVE_URL follows it.
OBSERVE_PORT=4981

# Where the dashboard's SQLite DB lives. Empty = the named docker volume
# instantcoffee-observe-data. On Docker Desktop over WSL a host path has to be
# the Windows form (//c/...); set it in .env.local, it is machine-specific.
OBSERVE_DATA_DIR=

# The host pi's home as the host sees it, and the path pi itself uses for it.
# The dashboard reads transcripts and the Instructions files from here, at the
# same absolute path pi records, so both must be set when they differ (Docker
# Desktop over WSL: //c/... on the left, the WSL home on the right). Empty =
# $HOME for both. pi-container.sh's home comes from PI_CONTAINER_HOME_HOST.
OBSERVE_PI_HOME_HOST=
OBSERVE_PI_HOME=

# warn | debug | trace
OBSERVE_LOG_LEVEL=warn

# 1 = the Instructions page can edit AGENTS.md and agent definitions through
# the read-write home mount above. 0 makes the dashboard read-only there.
OBSERVE_INSTRUCTIONS=1
