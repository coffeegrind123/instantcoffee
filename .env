##############################################################################
# qwen3.6-forge — single source of truth for the whole stack.
#
# This file is COMMITTED on purpose: the pins below are what make the setup
# reproducible. It contains no secrets.
#
# For machine-local overrides that should NOT be committed, create .env.local
# (gitignored) with the same keys — the scripts merge it on top of this file.
##############################################################################

# ---------------------------------------------------------------------------
# Pins — bumped by scripts/update.sh, which also rewrites versions.lock.
# ---------------------------------------------------------------------------
# Immutable per-build tag of ggml-org/llama.cpp (NOT the floating :server-cuda).
LLAMA_TAG=server-cuda-b10200
# forge-guardrails release from PyPI.
FORGE_VERSION=0.8.2

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Where GGUFs live on disk. Docker Desktop bind mounts the WINDOWS path, so this
# must be a //<drive>/... style path, not a WSL path. D: has the free space;
# C: does not (see context/design/decisions.md).
MODELS_DIR=//d/llm-models

MODEL_REPO=unsloth/Qwen3.6-27B-MTP-GGUF
GGUF_FILE=Qwen3.6-27B-UD-Q4_K_XL.gguf
# Name the API reports. llama.cpp ignores the model field clients send, so this
# is cosmetic — but it is what shows up in /v1/models and in client UIs.
MODEL_ALIAS=qwen3.6-27b

# Vision projector. Empty = text-only (the default; forge does not use vision).
# Set to mmproj-F16.gguf and re-run scripts/download-model.sh to enable images.
MMPROJ_FILE=

# ---------------------------------------------------------------------------
# llama-server tuning — sized for a 24 GB RTX 4090.
# ---------------------------------------------------------------------------
# Context per slot. pi's own prompt is small — no MCP, no sub-agents, and with
# -nc no AGENTS.md discovery either — so nearly all of this is available to the
# session itself rather than being spent before the first message. Paired with
# the quantized KV cache below it lands near 19.8 GiB of the ~22.4 GiB free.
# See the VRAM table in README.md before raising it further.
CTX_SIZE=65536
# Offload every layer. 999 = "all", clamped by llama.cpp to the real count.
NGL=999
# Flash attention: on | off | auto. Recent llama.cpp requires a VALUE here.
FLASH_ATTN=on
# Concurrent slots. 1 gives the single user the whole CTX_SIZE.
PARALLEL_SLOTS=1

# MTP speculative decoding. The MTP GGUF carries a multi-token-prediction head
# that llama.cpp can use to draft tokens and verify them in one pass — decode
# speed only, output is identical. Requires MODEL_REPO to be the *-MTP-GGUF
# variant. Set SPEC_TYPE empty to turn it off.
# n-max is the draft length: a public Qwen3.6 rig measured 2 as fastest, with 3
# no better and 4 collapsing back to non-MTP speed. Worth re-measuring here.
# n-min: minimum draft tokens (0 = auto, lets engine fall back when acceptance
# is low). p-min: minimum per-token acceptance probability — higher values
# draft less aggressively. The defaults below are from Qwen public presets.
# The mixmod repo (43★, rndhouse) runs n-max=6 on Q4_K_M.
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.75

# Thinking budget in tokens: -1 unrestricted, 0 disables thinking entirely,
# N>0 caps it. Unrestricted thinking is what hangs runs / fills the KV cache on
# reasoning-tagged models, so this is capped by default.
REASONING_BUDGET=4096

# Language the model reasons in. off | zh
# ENABLED 2026-08-11, by operator decision, ahead of measurement. From the HN
# thread of the same date (dannyw): Qwen's thinking is claimed to be strongest
# and most token-efficient in Mandarin, because that is what it was most
# natively trained on. The follow-up in that thread — "better thinking, or just
# shorter?" (kadoban) — was never answered and nobody posted a number, so this
# is running on a community claim rather than a local result.
#
# Nothing enforces it server-side: neither llama-server nor forge can inject a
# system prompt (see prompts/README.md), so the launchers append
# prompts/think-<lang>.md client-side.
#
# Confirm it on this hardware, and record the numbers:
#   ./scripts/ab-think-lang.sh --repeat 3 --save
# Back it out with one edit — THINK_LANG=off — if tool arguments come back with
# Chinese in them, which is the failure that breaks edits and file paths.
THINK_LANG=zh

# Sampling. Qwen publishes two thinking-mode presets: 1.0 for general use and
# 0.6 for "precise coding". 0.6 is the right one for a coding agent, and two
# independent public Qwen3.6 rigs converged on it. Client requests override.
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# ---------------------------------------------------------------------------
# Prompt cache & KV checkpointing — from pierotofy/LocalCodingLLM (27★),
# sasasin/dotfiles, rcarmo/llama-cpp, and loops-and-spells/pi-setup.
# ---------------------------------------------------------------------------
# Persist the KV cache to disk so warm restarts skip re-prefill. Set to 0 to
# disable (saves the RAM budget below but loses fast-restart).
CACHE_PROMPT=1
# RAM budget for the prompt cache in MiB. Upstream default: 8192. At 64K
# context, 8 GiB is a reasonable ceiling. 0 = disable, -1 = no limit.
CACHE_RAM=8192
# Reuse previous prompt cache entries. Higher = more cache hits but more CPU
# work per comparison. Engine default: 0 (disabled). sasasin config: 128.
CACHE_REUSE=64
# Prompt similarity threshold for cache reuse (0.0–1.0). Lower = more cache
# hits. sasasin config: 0.20. Only effective with CACHE_REUSE > 0.
SLOT_PROMPT_SIMILARITY=0.20
# Number of KV cache checkpoints per slot. Higher = more rewind points for
# agentic loops at the cost of VRAM. 0 = disable. Upstream default: 32.
# sasasin config: 24 with checkpoint-min-step 256.
CTX_CHECKPOINTS=16
# Minimum tokens between checkpoints. Smaller = more granular rewind.
# Upstream default: 8192. The sasasin config uses 256 for agentic workloads.
CHECKPOINT_MIN_STEP=256
# Custom message the engine emits when the reasoning budget is exhausted.
# Cleaner than the default — tells the model to stop and deliver.
REASONING_BUDGET_MESSAGE=Reasoning budget reached. Stop thinking and provide the final answer now.

# Appended verbatim to the llama-server command line. Whitespace-separated.
# KV cache: K at f16 (~64 KiB/token), V at q8_0 (~34 KiB/token).
# The HN thread is clear that quantizing K breaks JSON on tool calls and causes
# loops. f16 K costs ~2 GiB more at 64K but prevents unrecoverable edit failures.
# This model's 256-wide heads are in the CUDA flash-attention head-size table for
# both decode and prefill kernels regardless of cache quant.
# -b/-ub raise prompt-processing throughput, which is the dominant cost for an
# agent loop that re-sends a growing prompt every turn (the default ub of 512
# leaves the GPU idle). Two independent public Qwen3.6 configs raise these;
# larger batches also lower perplexity.
# -n is a server-side generation cap and a real backstop, not decoration: a
# request that arrives without n_predict falls back to this global value
# (tools/server/server-context.cpp — global_params.n_predict is consulted when
# the task did not set one). headroom's OpenAI shim renames max_tokens to
# max_completion_tokens, which llama.cpp does not read, so without this an
# uncapped generation would run until the context filled. Keep it equal to
# PI_MAX_TOKENS.
LLAMA_EXTRA_FLAGS=-ctk f16 -ctv q8_0 -b 4096 -ub 2048 -n 16384

# ---------------------------------------------------------------------------
# forge proxy
# ---------------------------------------------------------------------------
# native = forward the client's tools to llama.cpp's --jinja function calling.
# prompt = prompt-injection fallback (only for backends without native FC).
FORGE_CAPABILITY=native
FORGE_MAX_RETRIES=3
FORGE_MAX_TOOL_ERRORS=2
# none | keep-last | full — how much captured reasoning is replayed backend-side.
# Set to full (was none) per HN thread finding: preserve_thinking on the engine
# side avoids a full KV re-prefill every agentic turn. Paired with
# --chat-template-kwargs '{"preserve_thinking": true}' in docker-compose.yml.
FORGE_REASONING_REPLAY=full
# Generous: a 27B on one 4090 with a 4k thinking budget can take a while.
FORGE_BACKEND_TIMEOUT=600
# Appended verbatim to the forge command line. Useful additions:
#   --inject-respond-tool   keep small models in tool-calling mode
#   -v                      debug logging
FORGE_EXTRA_FLAGS=

# ---------------------------------------------------------------------------
# Eval harness — coding-specific evaluation beyond the smoke test.
# Runs via: docker compose --profile tools run --rm eval
# ---------------------------------------------------------------------------
EVAL_TIMEOUT=900
EVAL_REPEAT_THRESHOLD=3
EVAL_SCORE_FLOOR=0.5
# Whether eval.py lets the model think. off | on
# The committed scorecard is measured with thinking OFF — eval.py has always
# sent chat_template_kwargs={"enable_thinking": false}, so every number in the
# README describes the no-thinking path, while a real pi session runs with
# thinking on under REASONING_BUDGET. Leave this off to keep the scorecard
# comparable to the committed history; set it on to measure what you actually
# run. The mode is stamped into results/latest.json either way, so a run can
# never be mistaken for the other kind.
EVAL_THINKING=off
# Appended to eval.py requests as a system message. Empty = none. Set to
# /work/prompts/think-zh.md to score the stack as THINK_LANG=zh would run it.
EVAL_SYSTEM_PROMPT_FILE=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps both services host-only. Use 0.0.0.0 to expose on the LAN.
BIND_ADDR=127.0.0.1
LLAMA_PORT=8080
FORGE_PORT=8081

# ---------------------------------------------------------------------------
# pi (scripts/pi-local.sh) — the only client this stack targets.
# ---------------------------------------------------------------------------
# Generation cap advertised to pi as maxTokens, and the value LLAMA_EXTRA_FLAGS
# mirrors in -n. Deliberately well under CTX_SIZE: with --no-context-shift a
# request that would overflow fails loudly, and an agent loop's prompt grows
# every turn, so the reply has to leave room for the turn after it.
PI_MAX_TOKENS=16384
# 0 passes -nc, which skips AGENTS.md / CLAUDE.md discovery. pi walks parent
# directories looking for those, and on a 64K window they are a real fraction
# of the budget. Set to 1 when you want the project's conventions loaded.
PI_CONTEXT_FILES=0
# Shell aliases do NOT apply inside scripts — bash only expands them in
# interactive shells. Anything your own `pi` alias adds has to be repeated here
# or pi-local.sh launches without it. --print-only shows what will actually run.
PI_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# MCP, without MCP (scripts/mcp.sh + skills/mcp-tools)
#
# pi has no MCP support and this stack does not want it — one server can publish
# hundreds of tool schemas into a 64K window before the first message. mcp2cli
# turns an MCP server into a CLI instead, so a schema costs tokens only at the
# moment the model decides to use that one tool.
#
# 1 loads skills/mcp-tools into the session, which is what teaches the model
# that ./scripts/mcp.sh exists. Only the skill's name and description sit in the
# prompt (~60 tokens); pi loads the body on demand. Servers are declared in
# mcp/servers.json.
# ---------------------------------------------------------------------------
MCP2CLI_ENABLED=0
MCP2CLI_VERSION=3.3.1
# Load-bearing pin, not caution. mcp2cli 3.3.1 reads `Tool.inputSchema`; the MCP
# Python SDK renamed it to `input_schema` in 2.0.0, so an unpinned install
# resolves 2.0.0 and every MCP call dies with AttributeError before reaching the
# server. Verified both ways on 2026-08-12. Raise this only once mcp2cli
# supports SDK 2.x.
MCP_SDK_VERSION=1.29.0

# ---------------------------------------------------------------------------
# headroom — context compression in front of forge (scripts/headroom.sh).
#
#   pi  ->  headroom :8787  ->  forge :8081  ->  llama :8080
#
# OFF by default. Everything in results/ was measured without it, and a
# compressor in the path changes what the model sees, so it does not get to be
# on until ./scripts/ab-headroom.sh says it earns its place on this model.
# ---------------------------------------------------------------------------
# 1 makes scripts/pi-local.sh point pi at headroom instead of forge. The
# compose service is behind the "headroom" profile either way, so it only runs
# when you ask for it: ./scripts/headroom.sh up
HEADROOM_ENABLED=0
# headroom-ai release from PyPI. GHCR publishes only sha-<commit> tags for this
# project, no semver, so the pinnable artifact is the PyPI version and the image
# is built from it — same reasoning as FORGE_VERSION.
HEADROOM_VERSION=0.34.0
HEADROOM_PORT=8787
# How compressed content stays recoverable. Sized for a 27B, not for Opus:
#   lossless  format-native compaction only, no CCR markers and no injected
#             headroom_retrieve tool. Nothing the model sees is unrecoverable,
#             and no extra tool schema competes with the real ones. THE DEFAULT.
#   ccr       lossy compression plus an injected headroom_retrieve tool the
#             model must call to get the original back. More savings, and it
#             rests on this model reliably choosing to call it — the tools
#             suite scores 0.73 here, so measure before believing it.
#   lossy     maximum savings, no recovery path at all. Only with evidence.
HEADROOM_RECOVERY=lossless
# Kompress keep-ratio for text: 0.4 keeps ~40% of tokens, lower is more
# aggressive. Empty = let Kompress decide from its own importance threshold,
# which is the conservative setting. This is the lever that matters here:
# headroom sizes compression against the model's context window, and
# qwen3.6-27b is not in LiteLLM's model table, so it falls back to a 128K
# default — twice this stack's real 64K window.
HEADROOM_TARGET_RATIO=
# Appended verbatim to the headroom command line. Useful additions:
#   --learn                 mine recurring traffic patterns into memory
#   --intercept-tool-results  opt into the tool_result interceptors
HEADROOM_EXTRA_FLAGS=
